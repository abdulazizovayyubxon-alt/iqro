# Vercel Deployment uchun kerak bo'lmagan fayl va papkalar

# Darsliklar va darslik PDF fayllari (juda katta hajmda)
fan/
*.pdf

# Dizayn va logolar
dizayin/
design_handoff_iqro_redesign/

# Qo'shimcha materiallar va bekaplar
ped M/
ped mahorat/
Qoshimcha 3/
scratch/
pipeline/

# Mahalliy build va dependensiyalar
dist/
node_modules/
.env

# Vercel Hobby limit (12 Serverless functions) uchun foydalanilmaydigan yoki birlashtirilgan API-lar
#
# DIQQAT: api/_shared.js bu ro'yxatga QO'SHILMAYDI — u endpointlar tomonidan
# import qilinadi. `_` bilan boshlangani uchun Vercel uni funksiya deb hisoblamaydi
# (12 ta chegaraga kirmaydi), lekin fayl deploy'da BO'LISHI SHART.
api/set-webhook.js
api/send-otp.js
api/verify-otp.js

# Unit testlar — production bundle'iga kerak emas
#
# ⚠️ DIQQAT: `npm run build` ichidagi `verify` qadami shu qatorga BOG'LIQ.
#   Testlar deploy paketiga tushmagani uchun Vercel'da vitest 0 ta fayl
#   topadi. Shuning uchun `verify` da `--passWithNoTests` bor: Vercel'da
#   faqat ESLint qo'riqlaydi (aynan u "X is not defined" sinfini tutadi),
#   testlar esa lokalda `npm run verify` bilan to'liq yuriydi.
#   Bu qatorni olib tashlasangiz — testlar deploy'da ham yuradi (2026-08-28).
src/__tests__/
