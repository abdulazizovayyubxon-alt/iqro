rules_version = '2';

// Firebase Storage xavfsizlik qoidalari
service firebase.storage {
  match /b/{bucket}/o {

    // Profil avatarlari: hamma o'qiy oladi (umumiy ko'rinish uchun),
    // faqat egasi o'z papkasiga rasm yozadi (maks 5 MB, faqat rasm fayli)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Savol rasmlari (AdminPage → handleImageUpload).
    //
    // ⚠️ DIQQAT (audit 2026-08-05): bu yo'l avval `allow write: if false`
    // ostida qolib ketgan edi — ya'ni admin panelidagi "rasm yuklash" tugmasi
    // HECH QACHON ishlamagan (permission-denied). Hozirgi savol rasmlari
    // repoda statik fayl sifatida turadi (public/art_img/...), shuning uchun
    // bu bug sezilmagan.
    //
    // O'qish OCHIQ: rasm havolasi savol matnida bo'ladi va u pullik kontent
    // emas (rasmning o'zi savolni oshkor qilmaydi). Yozuv esa faqat
    // ro'yxatdagi platforma adminlarida — Storage qoidalari Firestore'ni
    // o'qiy olmaydi, shuning uchun rol emailga qarab tekshiriladi.
    match /questions/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
             'abdulazizovayyubxon@gmail.com',
             '998999154686@iqro.uz'
           ]
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Savol paketlari ──────────────────────────────────────────────────
    //
    // O'QISH — HAR DOIM TAQIQ. Bu qoidaning o'zagi: mijoz bu faylga HECH
    // QACHON to'g'ridan-to'g'ri tegmaydi. Savollar FAQAT /api/get-questions
    // orqali beriladi, u esa Admin SDK bilan o'qiydi (Admin SDK Storage
    // qoidalaridan mustaqil).
    //
    // ⚠️ `getDownloadURL()` NI HECH QAYERDA CHAQIRMANG. U `?token=` havolasi
    // yaratadi va o'sha havola shu qoidani butunlay chetlab o'tadi — aynan
    // shu 2026-08-05 auditidagi teshik edi (pullik baza login'siz oqib
    // ketardi). AdminPage paketni `uploadBytes` bilan yuklaydi va faqat
    // ICHKI YO'LNI (`bundles/<fan>.json`) Firestore'ga yozadi.
    //
    // YOZISH — faqat platforma adminlari. Storage qoidalari Firestore'ni
    // o'qiy olmaydi, shuning uchun rol emailga qarab tekshiriladi (yuqoridagi
    // `questions/` bilan bir xil naqsh). 25 MB — eng katta fan (~3 700 savol,
    // ~2.6 MB) uchun keng zaxira, lekin cheksiz emas.
    match /bundles/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.email in [
             'abdulazizovayyubxon@gmail.com',
             '998999154686@iqro.uz'
           ]
        && request.resource.size < 25 * 1024 * 1024
        && fileName.matches('[a-z0-9_]+\\.json');
    }

    // Boshqa barcha yo'llar: standart ravishda taqiqlangan
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
