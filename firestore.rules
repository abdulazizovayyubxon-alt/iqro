rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin tekshirish funksiyasi ──
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'abdulazizovayyubxon@gmail.com' ||
        request.auth.token.email == '998999154686@iqro.uz' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Pullik kontentga kirish huquqi ────────────────────────────────────
    // AUDIT 2026-08-05, 2-BAND: avval `questions` ni ISTALGAN kirgan hisob
    // to'liq o'qiy olardi — ya'ni api/get-questions.js dagi premium tekshiruvi
    // bezak edi va ~47k savollik pullik baza bepul hisob uchun ochiq turardi.
    //
    // `createdAt` timestamp bo'lmasa ATAYLAB ruxsat beriladi (fail-open):
    // eski hisoblarda bu maydon satr ko'rinishida bo'lishi mumkin, ularni
    // qulflab qo'ymaymiz. Bu XAVFSIZ, chunki `createdAt` endi himoyalangan
    // maydonlar ro'yxatida — mijoz uni o'zgartira olmaydi.
    function hasContentAccess() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.isPremium == true
        || !('createdAt' in u)
        || !(u.createdAt is timestamp)
        || request.time < u.createdAt + duration.value(7, 'd');
    }

    // ── userStats: o'z ma'lumotlari yoziladi, reyting uchun hamma o'qiydi ──
    //
    // AUDIT 2026-08-05, 11-BAND: avval maydon tekshiruvi umuman yo'q edi —
    // `setDoc(doc(db,'userStats',uid), { totalScore: 999999 })` bir so'rovda
    // reyting 1-o'rnini berardi (LeaderboardPage orderBy(scoreField)).
    //
    // Tekshiruv DELTA bo'yicha, absolyut qiymat bo'yicha EMAS. Nega shunday:
    // absolyut invariant (masalan `totalScore <= totalAnswered*2 + N`) mavjud
    // ma'lumotga bog'liq bo'lardi — legacy hisoblash tufayli bitta foydalanuvchi
    // hujjati unga mos kelmasa, o'sha odamning BARCHA keyingi yozuvlari
    // (hatto `todayPlan` kabi begona maydonlar ham) jimgina rad etilardi.
    // Delta tekshiruvi tarixdan mustaqil.
    //
    // Ball manbasi (AppContext.jsx:668): yangi savol 2, vaqti kelgan takror 1,
    // kunlik maqsad bonusi 5/kun. Demak ball o'sishi javob o'sishining
    // ikki barobaridan oshmaydi; 5000 zaxira bonuslar va faqat-takror
    // sessiyalari uchun (SmartReviewPage ham totalAnswered'ni oshiradi).
    //
    // Kamayish ERKIN: bu statistikani ataylab tiklash yo'li
    // (AppContext.jsx:963 `merge:false`), aldov esa DOIM oshirishga urinadi.
    //
    // ⚠️ Bu YUMSHATISH, to'liq yechim EMAS: ko'p yozuv bilan bosqichma-bosqich
    // ko'tarish hamon mumkin (bir yozuvda maksimal +5000). To'liq butunlik
    // uchun test natijasini SERVER qabul qilishi kerak — keyingi bosqich.
    function statsDeltaOk() {
      let d = request.resource.data;
      let prevScore = resource == null ? 0 : resource.data.get('totalScore', 0);
      let prevAns   = resource == null ? 0 : resource.data.get('totalAnswered', 0);
      let newScore  = d.get('totalScore', 0);
      let newAns    = d.get('totalAnswered', 0);

      return newScore is number && newAns is number
        && newScore >= 0 && newAns >= 0
        && newAns <= 5000000
        && (newScore - prevScore) <= (newAns - prevAns) * 2 + 5000;
    }

    match /userStats/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isAdmin() || (isOwner(userId) && statsDeltaOk());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── questions: pullik kontent — faqat premium/trial o'qiydi ──
    match /questions/{docId} {
      allow read: if isLoggedIn() && hasContentAccess();
      allow create, update: if isAdmin() && (
        (request.resource.data.topicId >= 0 && request.resource.data.topicId <= 6 && request.resource.data.category == 'chqbt') ||
        (request.resource.data.topicId >= 7 && request.resource.data.topicId <= 14 && request.resource.data.category == 'art') ||
        (request.resource.data.topicId >= 15 && request.resource.data.topicId <= 22 && request.resource.data.category == 'tarix') ||
        (request.resource.data.topicId >= 23 && request.resource.data.topicId <= 30 && request.resource.data.category == 'sport') ||
        (request.resource.data.topicId >= 31 && request.resource.data.topicId <= 38 && request.resource.data.category == 'boshlangich') ||
        (request.resource.data.topicId >= 39 && request.resource.data.topicId <= 46 && request.resource.data.category == 'info') ||
        (request.resource.data.topicId >= 47 && request.resource.data.topicId <= 54 && request.resource.data.category == 'mtt') ||
        // til va adabiyot (adabiyot -> til ko'chirilishi uchun vaqtincha ruxsat)
        (request.resource.data.topicId >= 55 && request.resource.data.topicId <= 62 && (request.resource.data.category == 'til' || request.resource.data.category == 'adabiyot')) ||
        // mtt_rahbar (63-70)
        (request.resource.data.topicId >= 63 && request.resource.data.topicId <= 70 && (request.resource.data.category == 'mtt_rahbar' || request.resource.data.category == 'adabiyot')) ||
        // nemis tili (71-79)
        (request.resource.data.topicId >= 71 && request.resource.data.topicId <= 79 && request.resource.data.category == 'nemis') ||
        // ── YANGI fanlar (fan 2), topicId 80-113 ──
        (request.resource.data.topicId >= 80 && request.resource.data.topicId <= 86 && request.resource.data.category == 'biologiya') ||
        (request.resource.data.topicId >= 87 && request.resource.data.topicId <= 96 && request.resource.data.category == 'geografiya') ||
        (request.resource.data.topicId >= 97 && request.resource.data.topicId <= 106 && request.resource.data.category == 'mtt_logoped') ||
        (request.resource.data.topicId >= 107 && request.resource.data.topicId <= 113 && request.resource.data.category == 'mtt_psixolog') ||
        // ── YANGI fanlar (fan 2 — 2-to'plam), topicId 114-136 ──
        (request.resource.data.topicId >= 114 && request.resource.data.topicId <= 120 && request.resource.data.category == 'kimyo') ||
        (request.resource.data.topicId >= 121 && request.resource.data.topicId <= 128 && request.resource.data.category == 'rus_tili') ||
        (request.resource.data.topicId >= 129 && request.resource.data.topicId <= 136 && request.resource.data.category == 'ingliz') ||
        // ── MTT jismoniy tarbiya yo'riqchisi (fan 3), topicId 137-145 ──
        (request.resource.data.topicId >= 137 && request.resource.data.topicId <= 145 && request.resource.data.category == 'mtt_jismoniy')
      );
      allow delete: if isAdmin();
    }

    // ── questionBundles: savol paketining bo'laklari (tezlik uchun) ──────────
    //
    // NEGA BOR: Storage loyihada yoqilmagan, shuning uchun savol paketi
    // `questionBundles/{fan}__{n}` hujjatlarida JSON satr sifatida saqlanadi.
    // Busiz ilova `getDocs(where('category','==',fan))` ga tushib, HAR sovuq
    // yuklashda fan boshiga ~2 900 o'qish sarflaydi (kunlik kvota 50 000).
    //
    // O'QISH BUTUNLAY YOPIQ: bu — pullik kontentning to'liq nusxasi, bitta
    // hujjatda. Ochiq bo'lsa, `questions` kolleksiyasidagi `hasContentAccess()`
    // tekshiruvi ma'nosiz bo'lardi — istalgan kirgan hisob butun bazani
    // 4 ta arzon o'qish bilan yuklab olardi.
    // Yagona o'quvchi — api/get-questions.js (Admin SDK qoidalarni chetlab
    // o'tadi), u premium/trial tekshiruvidan keyin uzatadi.
    // Yozuv — scripts/build-fs-bundle.mjs (admin hisobi bilan).
    match /questionBundles/{docId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // ── objections: foydalanuvchi faqat O'Z e'tirozini o'qiydi (maxfiylik); admin hammasini boshqaradi ──
    match /objections/{docId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── answerEvents: savol statistikasi uchun xom javob jurnali ──
    //
    // ADMIN UX AUDIT 2026-08-18, A-1. Mijoz test yakunida BITTA hujjat yozadi,
    // api/cron-daily.js uni `questionStats` ga agregatlab O'CHIRADI.
    //
    // O'QISH BERILMAGAN: jurnalda boshqa foydalanuvchining javoblari bo'lishi
    // mumkin emas, lekin baribir kerak emas — mijoz o'z yozganini qayta
    // o'qimaydi. Cron esa Admin SDK bilan ishlaydi va qoidalarni chetlab o'tadi.
    //
    // `log` HAJMI CHEKLANGAN: aks holda bitta foydalanuvchi ulkan massiv yozib
    // agregatsiyani ham, kvotani ham buzishi mumkin edi. 200 — eng uzun
    // imtihondan (50 savol) ancha katta zaxira.
    match /answerEvents/{docId} {
      allow create: if isLoggedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.log is list
                    && request.resource.data.log.size() > 0
                    && request.resource.data.log.size() <= 200;
      allow read, update: if false;
      allow delete: if isAdmin();
    }

    // ── questionStats: savol bo'yicha agregat (ko'rsatilgan/xato/variant tanlovi) ──
    //
    // FAQAT cron yozadi (Admin SDK). Mijoz yoza olsa, "shubhali savollar"
    // ro'yxatini istagancha buzish mumkin bo'lardi.
    match /questionStats/{questionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── questionRequests: "Ko'proq savol kerak" so'rovi — foydalanuvchi o'z so'rovini yuboradi/o'qiydi, admin boshqaradi ──
    match /questionRequests/{docId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── users: foydalanuvchi profili (faqat o'zini o'qiydi yoki admin) ──
    //
    // HIMOYALANGAN MAYDONLAR — mijoz ularga HECH QACHON yozmaydi.
    // Faqat Admin SDK (api/*) yoki platforma admini o'zgartiradi.
    //
    // ⚠️ AUDIT 2026-08-05, 1-BAND — nima uchun ro'yxat kengaytirildi:
    //   `referralDiscount` ro'yxatda YO'Q edi, api/payment-webhook.js esa
    //   kutilgan to'lov summasini AYNAN shu maydondan hisoblardi. Foydalanuvchi
    //   konsolda `referralDiscount: 99` yozib narxning 1%ini to'lab to'liq
    //   premium olishi mumkin edi. Shu bilan birga:
    //     · referralCount  → 0 ga qaytarib MAX_REFERRALS chegarasini chetlab o'tish
    //     · referredBy     → o'ziga-o'ziga taklif yozib bonus farming
    //     · referralCode   → boshqa odamning kodini o'zlashtirib olish
    //     · premiumTransId → idempotentlik qulfini buzish
    //   Bu maydonlarni yozish api/find-referral.js ga (Admin SDK) ko'chirildi.
    function protectedUserFields() {
      return [
        // ── obuna va to'lov ──
        'role', 'isPremium', 'premiumPlan', 'premiumExpire', 'freeExpire',
        'premiumMethod', 'premiumSince', 'premiumTransId', 'promoUsedOnPayment',
        // ── trial hisobining ASOSI ──
        // `createdAt` trial muddatini belgilaydi (AuthContext computeTrial):
        // uni "bugun"ga o'zgartirib sinov muddatini cheksiz tiklash mumkin edi.
        // `freeMonthExpire` esa to'g'ridan-to'g'ri 'premium' holatini beradi.
        'createdAt', 'freeMonthExpire', 'reminderSent',
        // ── chegirma va bonus (to'lov summasiga TA'SIR QILADI) ──
        'referralDiscount', 'referralBonus', 'referralCount', 'referredBy',
        'referralCode', 'discountExpired', 'discountExpiredAt',
        'promoDiscount', 'promoRedeemed',
        // ── B2B maktab a'zoligi ──
        'schoolId', 'schoolName', 'schoolJoinedAt',
        // ── Hamkor ustoz portali ──
        // ⚠️ HAMKOR AUDITI 2026-08-15: `partnerCode` himoyalanmagan edi.
        // api/partner.js unga qarab hisobotga ruxsat berardi, ya'ni istalgan
        // foydalanuvchi o'z hujjatiga ommaviy tarqatilgan promokodni yozib,
        // o'sha guruh ustozlarining ism/ID/natijalarini ko'ra olardi.
        // Kod tomonda ham tuzatildi (rol tekshiruvi), bu — ikkinchi qatlam.
        'partnerCode'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && (request.resource.data.isPremium == false || !('isPremium' in request.resource.data))
                    // Ro'yxatdan o'tishda chegirma/bonus maydonlari bilan
                    // "tug'ilish" ham mumkin emas (create update'ni chetlab o'tardi)
                    && !request.resource.data.keys().hasAny([
                         'referralDiscount', 'referralBonus', 'referralCount',
                         'referredBy', 'premiumTransId', 'promoDiscount'
                       ]);
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(protectedUserFields())
      );
      allow delete: if isAdmin();
    }

    // ── referrals: taklif qilinganlar va bonuslar ──
    //
    // ⚠️ AUDIT 2026-08-05, 1-BAND: avval `allow create: if isLoggedIn()` edi —
    // maydon tekshiruvi YO'Q. Ya'ni istalgan foydalanuvchi ixtiyoriy
    // `referrerId`/`referredId`/`bonusPaid` bilan hujjat yasab, to'lovdan keyin
    // o'ziga-o'ziga 15 000 so'mlik bonus yozdirishi mumkin edi.
    // ENDI: yozuv FAQAT api/find-referral.js (Admin SDK) orqali — u rules'ni
    // chetlab o'tadi, demak mijoz uchun create butunlay yopiladi.
    match /referrals/{docId} {
      allow create: if false;
      allow read: if isLoggedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── payments: to'lov audit jurnali (api/payment-webhook.js yozadi) ──
    // MOLIYAVIY iz — mijoz na o'qiydi, na yozadi. Faqat admin ko'radi
    // ("to'ladim, premium yo'q" murojaatlarini tekshirish uchun).
    match /payments/{transId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── settings: tariflar va sozlamalar (hamma o'qiydi, admin yoza oladi) ──
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── notifications: hamma o'qiy oladi, faqat admin yoza/o'chira oladi ──
    match /notifications/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── users/{uid}/notifications: shaxsiy bildirishnomalar (akademik yutuqlar) —
    // faqat egasi o'qiydi/yozadi, admin ham boshqara oladi ──
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── leaderboard: LEGACY — reyting `userStats` dan o'qiladi (LeaderboardPage.jsx:114).
    // Bu kolleksiyaga mijoz kodida bironta yozuv yo'q, shuning uchun yozuv
    // yopildi: tekshirilmagan `allow write: if isOwner()` ochiq turishining
    // ma'nosi yo'q edi.
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── promoCodes: faqat admin boshqaradi; redemption FAQAT server (Admin SDK) orqali ──
    match /promoCodes/{code} {
      allow read, write: if isAdmin();
    }

    // ── promoCodes/{code}/redemptions/{uid}: kim ishlatgani ──
    // AUDIT 2026-08-05, 15-BAND: avval `usedBy` MASSIVIGA arrayUnion qilinardi.
    // Ommaviy kampaniya kodida (maxUses ko'p) massiv 1MB hujjat chegarasiga
    // urilib, kod QAYTARILMAS holda ishdan chiqardi. Endi har foydalanuvchi
    // alohida hujjat. Yozuv faqat server (api/redeem-promo.js).
    match /promoCodes/{code}/redemptions/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    // ── partnerSets: hamkor ustozning YOPIQ haftalik to'plamlari ──
    //
    // YOPIQLIK shu yerda hal bo'ladi, mijozda emas: o'qish huquqi shu
    // promokodni TASDIQLAGAN guruh a'zolariga bog'langan. Guruhdan
    // tashqaridagi foydalanuvchi so'rov yuborsa — Firestore rad etadi,
    // savollar uning qurilmasiga umuman yetib bormaydi.
    //
    // TUZILISH — ataylab ikki qavat:
    //   partnerSets/{setId}                  → faqat METAMA'LUMOT (nom, tartib)
    //   partnerSets/{setId}/content/questions → savollar massivi
    // Sabab: haftalar RO'YXATI ochilganda barcha savollar ham yuklanib
    // ketmasin. Ro'yxat = bir necha yengil hujjat, hafta ochilganda esa
    // qo'shimcha 1 ta o'qish. Savollarni subkolleksiyada har biri alohida
    // hujjat qilib saqlamaymiz — u holda 30 savol = 30 o'qish bo'lardi.
    //
    // `hasContentAccess()` ATAYIN qo'yilmadi: ustoz kodni tasdiqlagan
    // zahoti haftalik to'plamni ko'ra olishi kerak — obuna holati bu yerda
    // to'siq bo'lmasin.
    function isGroupMember(code) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/promoCodes/$(code)/redemptions/$(request.auth.uid));
    }

    match /partnerSets/{setId} {
      allow read: if isAdmin() || isGroupMember(resource.data.partnerCode);
      // Yozuv faqat admin: savol mazmuni va `correct` maydoni hamkor
      // ustozning o'ziga ham ochilmaydi (u faqat natijalarni ko'radi).
      allow write: if isAdmin();

      // `partnerCode` bu yerda ham TAKRORLANADI — aks holda qoida ota
      // hujjatni `get()` bilan o'qishga majbur bo'lardi, ya'ni har savol
      // to'plamini ochishda qo'shimcha hujjat o'qishi sarflanardi.
      match /content/{docId} {
        allow read: if isAdmin() || isGroupMember(resource.data.partnerCode);
        allow write: if isAdmin();
      }
    }

    // ── schools: B2B maktab paketlari ──
    // joinCode MAXFIY bo'lishi kerak — aks holda istalgan foydalanuvchi
    // istalgan maktabga qo'shilib, korporativ obunani o'zlashtirib olardi.
    // Shu sababli o'qish faqat: platforma admini, maktab admini yoki a'zo.
    // YOZUV faqat platforma adminida; qo'shilish esa api/school.js (Admin SDK).
    match /schools/{schoolId} {
      allow read: if isAdmin()
        || (isLoggedIn() && request.auth.uid in resource.data.adminUids)
        || (isLoggedIn() && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)));
      allow write: if isAdmin();
    }

    // ── schools/{id}/members: a'zolar ro'yxati ──
    // O'zini va maktab admini butun ro'yxatni o'qiy oladi. Yozuv — faqat server.
    match /schools/{schoolId}/members/{memberId} {
      allow read: if isAdmin()
        || isOwner(memberId)
        || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.adminUids);
      allow write: if isAdmin();
    }

    // ── schoolRequests: maktab uchun korporativ paket so'rovi ──
    // Foydalanuvchi o'z so'rovini yuboradi/o'qiydi; boshqarish faqat adminda.
    match /schoolRequests/{docId} {
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.schoolName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20;
      allow read: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── deletionRequests: hisobni o'chirish arizasi (/delete-account) ──
    //
    // AUDIT 2026-08-05, 7-BAND: avval create AUTENTIFIKATSIYASIZ ruxsat etilardi
    // (sahifa ochiq — Google Play talabi). Maydonlar qat'iy tekshirilgan bo'lsa
    // ham, CHEGARA yo'q edi: istalgan odam cheksiz hujjat yaratib Firestore
    // kvotasini tugatishi va admin panelini spam bilan to'ldirishi mumkin edi.
    //
    // ENDI: yozuv api/notify-admin.js?action=delete-request orqali (Admin SDK,
    // IP bo'yicha rate-limit). Sahifa avvalgidek autentifikatsiyasiz ishlaydi.
    match /deletionRequests/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── meta/counters: qisqa foydalanuvchi ID (shortId) uchun ketma-ket hisoblagich ──
    //
    // ⚠️ 2026-08-14 TEKSHIRUVI — nima uchun mijoz uchun BUTUNLAY yopildi:
    // Avval `allow update: if isLoggedIn() && userSeq == oldingi + 1` edi, ya'ni
    // ID ni har bir MIJOZ o'zi generatsiya qilardi. Bu bitta umumiy hujjat —
    // "issiq nuqta". Ikki kishi bir vaqtda ursa, mag'lubi ABORTED emas
    // PERMISSION_DENIED olardi, Firestore SDK esa bunday xatoni qayta urinmaydi.
    // Natija: 99 hisobdan 17 tasi ID'siz qolgan edi.
    //
    // ENDI ID ni FAQAT server beradi — api/_shared.js `ensureShortIdAdmin`.
    // Admin SDK qoidalarni chetlab o'tadi, shuning uchun bu blok uni to'smaydi;
    // admin uchun ochiq qoldirilgani esa scripts/backfill-short-ids.mjs uchun.
    match /meta/counters {
      allow read, write: if isAdmin();
    }

    // ── errorLogs: kuzatuv (observability) — faqat admin o'qiydi/boshqaradi.
    // Client TO'G'RIDAN yozmaydi — yozuv faqat /api/log-error (Admin SDK) orqali,
    // u rules'ni chetlab o'tadi. Shu sababli client uchun write bloklangan. ──
    match /errorLogs/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ── adminActions: admin harakatlari jurnali (kim · qachon · nima qildi) ──
    //
    // ⚠️ ADMIN AUDIT 2026-08-06, B-5 BAND: panelda qaytarilmas amallar bor
    // (hisobni Auth bilan o'chirish, minglab savolni o'chirish, admin huquqi
    // berish), ular hech qayerda qayd etilmasdi. Adminlar soni birdan ortiq.
    //
    // Tahrirlash va o'chirish BUTUNLAY yopiq: jurnalni keyin o'zgartirib
    // bo'lmasa, u haqiqiy audit izi bo'la oladi. Faqat qo'shish mumkin.
    //
    // `actorUid` tokendagi uid bilan mos bo'lishi SHART — aks holda bir admin
    // boshqasining nomidan yozuv qoldirib, izni chalkashtirishi mumkin edi.
    //
    // ⚠️ EMULYATORDA SINALMAGAN (bu mashinada Java yo'q).
    match /adminActions/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── metrics: kunlik o'sish ko'rsatkichlari (api/cron-daily.js yozadi) ──
    //
    // Bir kun = bir hujjat (`metrics/2026-08-14`): jami/premium foydalanuvchi,
    // DAU, WAU, yangi ro'yxatdan o'tganlar. Ilgari bu raqamlar cron javobida
    // qaytib, hech qayerda SAQLANMASDAN yo'qolardi — shuning uchun panelda
    // o'sish grafigi qurib bo'lmasdi (2026-08-14 auditi).
    //
    // YOZUV MIJOZ UCHUN BUTUNLAY YOPIQ: cron Admin SDK bilan ishlaydi va
    // qoidalardan mustaqil. Ochiq qoldirilsa, istalgan foydalanuvchi soxta
    // "o'sish" yozib, biznes qarorlarini chalg'itishi mumkin edi.
    match /metrics/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Qolgan hamma narsa bloklangan ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
