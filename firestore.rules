rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin tekshirish funksiyasi ──
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'abdulazizovayyubxon@gmail.com' ||
        request.auth.token.email == '998999154686@iqro.uz' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── userStats: faqat o'z ma'lumotlari yoziladi, reyting uchun hamma o'qiydi, admin o'chira oladi ──
    match /userStats/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── questions: hamma o'qiy oladi, faqat admin yoza oladi (topicId↔category oralig'i bilan) ──
    match /questions/{docId} {
      allow read: if isLoggedIn();
      allow create, update: if isAdmin() && (
        (request.resource.data.topicId >= 0 && request.resource.data.topicId <= 6 && request.resource.data.category == 'chqbt') ||
        (request.resource.data.topicId >= 7 && request.resource.data.topicId <= 14 && request.resource.data.category == 'art') ||
        (request.resource.data.topicId >= 15 && request.resource.data.topicId <= 22 && request.resource.data.category == 'tarix') ||
        (request.resource.data.topicId >= 23 && request.resource.data.topicId <= 30 && request.resource.data.category == 'sport') ||
        (request.resource.data.topicId >= 31 && request.resource.data.topicId <= 38 && request.resource.data.category == 'boshlangich') ||
        (request.resource.data.topicId >= 39 && request.resource.data.topicId <= 46 && request.resource.data.category == 'info') ||
        (request.resource.data.topicId >= 47 && request.resource.data.topicId <= 54 && request.resource.data.category == 'mtt') ||
        // til va adabiyot (adabiyot -> til ko'chirilishi uchun vaqtincha ruxsat)
        (request.resource.data.topicId >= 55 && request.resource.data.topicId <= 62 && (request.resource.data.category == 'til' || request.resource.data.category == 'adabiyot')) ||
        // mtt_rahbar (63-70)
        (request.resource.data.topicId >= 63 && request.resource.data.topicId <= 70 && (request.resource.data.category == 'mtt_rahbar' || request.resource.data.category == 'adabiyot')) ||
        // nemis tili (71-79)
        (request.resource.data.topicId >= 71 && request.resource.data.topicId <= 79 && request.resource.data.category == 'nemis') ||
        // ── YANGI fanlar (fan 2), topicId 80-113 ──
        (request.resource.data.topicId >= 80 && request.resource.data.topicId <= 86 && request.resource.data.category == 'biologiya') ||
        (request.resource.data.topicId >= 87 && request.resource.data.topicId <= 96 && request.resource.data.category == 'geografiya') ||
        (request.resource.data.topicId >= 97 && request.resource.data.topicId <= 106 && request.resource.data.category == 'mtt_logoped') ||
        (request.resource.data.topicId >= 107 && request.resource.data.topicId <= 113 && request.resource.data.category == 'mtt_psixolog')
      );
      allow delete: if isAdmin();
    }

    // ── objections: foydalanuvchi faqat O'Z e'tirozini o'qiydi (maxfiylik); admin hammasini boshqaradi ──
    match /objections/{docId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── questionRequests: "Ko'proq savol kerak" so'rovi — foydalanuvchi o'z so'rovini yuboradi/o'qiydi, admin boshqaradi ──
    match /questionRequests/{docId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── users: foydalanuvchi profili (faqat o'zini o'qiydi yoki admin) ──
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && (request.resource.data.isPremium == false || !('isPremium' in request.resource.data));
      allow update: if isAdmin() || (
        isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'premiumPlan', 'premiumExpire', 'freeExpire', 'referralBonus', 'promoDiscount', 'promoRedeemed']))
      );
      allow delete: if isAdmin();
    }

    // ── referrals: taklif qilinganlar va bonuslar ──
    match /referrals/{docId} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── settings: tariflar va sozlamalar (hamma o'qiydi, admin yoza oladi) ──
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── notifications: hamma o'qiy oladi, faqat admin yoza/o'chira oladi ──
    match /notifications/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── users/{uid}/notifications: shaxsiy bildirishnomalar (akademik yutuqlar) —
    // faqat egasi o'qiydi/yozadi, admin ham boshqara oladi ──
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── leaderboard: hamma o'qiy oladi, faqat o'zi/admin yoza oladi ──
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── promoCodes: faqat admin boshqaradi; redemption FAQAT server (Admin SDK) orqali ──
    match /promoCodes/{code} {
      allow read, write: if isAdmin();
    }

    // ── deletionRequests: hisobni o'chirish arizasi (/delete-account) — sahifa ochiq,
    // shuning uchun create autentifikatsiyasiz ham ruxsat etiladi, lekin maydonlar qat'iy
    // tekshiriladi va o'qish/boshqarish faqat adminda ──
    match /deletionRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'reason', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() == 12
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt is string;
      allow read, update, delete: if isAdmin();
    }

    // ── meta/counters: ro'yxatdan o'tishda qisqa foydalanuvchi ID (shortId) generatsiya qilish uchun
    // ketma-ket hisoblagich. Faqat +1 oshirishga ruxsat — boshqa manipulyatsiya bloklangan ──
    match /meta/counters {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.keys().hasOnly(['userSeq']) && request.resource.data.userSeq == 1;
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userSeq'])
        && request.resource.data.userSeq == resource.data.userSeq + 1;
    }

    // ── errorLogs: kuzatuv (observability) — faqat admin o'qiydi/boshqaradi.
    // Client TO'G'RIDAN yozmaydi — yozuv faqat /api/log-error (Admin SDK) orqali,
    // u rules'ni chetlab o'tadi. Shu sababli client uchun write bloklangan. ──
    match /errorLogs/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Qolgan hamma narsa bloklangan ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
