rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin tekshirish funksiyasi ──
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'abdulazizovayyubxon@gmail.com' ||
        request.auth.token.email == '998999154686@iqro.uz' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── userStats: faqat o'z ma'lumotlari yoziladi, reyting uchun hamma o'qiydi, admin o'chira oladi ──
    match /userStats/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── questions: hamma o'qiy oladi, faqat admin yoza oladi ──
    match /questions/{docId} {
      allow read: if isLoggedIn();
      allow create, update: if isAdmin() && (
        (request.resource.data.topicId >= 0 && request.resource.data.topicId <= 6 && request.resource.data.category == 'chqbt') ||
        (request.resource.data.topicId >= 7 && request.resource.data.topicId <= 14 && request.resource.data.category == 'art') ||
        (request.resource.data.topicId >= 15 && request.resource.data.topicId <= 22 && request.resource.data.category == 'tarix') ||
        (request.resource.data.topicId >= 23 && request.resource.data.topicId <= 30 && request.resource.data.category == 'sport') ||
        (request.resource.data.topicId >= 31 && request.resource.data.topicId <= 38 && request.resource.data.category == 'boshlangich') ||
        (request.resource.data.topicId >= 39 && request.resource.data.topicId <= 46 && request.resource.data.category == 'info') ||
        (request.resource.data.topicId >= 47 && request.resource.data.topicId <= 54 && request.resource.data.category == 'mtt') ||
        // til va adabiyot (adabiyot -> til ko'chirilishi uchun vaqtincha ruxsat)
        (request.resource.data.topicId >= 55 && request.resource.data.topicId <= 62 && (request.resource.data.category == 'til' || request.resource.data.category == 'adabiyot')) ||
        // mtt_rahbar (63-70)
        (request.resource.data.topicId >= 63 && request.resource.data.topicId <= 70 && (request.resource.data.category == 'mtt_rahbar' || request.resource.data.category == 'adabiyot')) ||
        // nemis tili (71-79)
        (request.resource.data.topicId >= 71 && request.resource.data.topicId <= 79 && request.resource.data.category == 'nemis')
      );
      allow delete: if isAdmin();
    }

    // ── objections: hamma yoza oladi, faqat admin o'chira oladi ──
    match /objections/{docId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isAdmin();
    }

    // ── users: foydalanuvchi profili (faqat o'zini o'qiydi yoki admin) ──
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) 
                    && request.resource.data.role == 'user' 
                    && (request.resource.data.isPremium == false || !('isPremium' in request.resource.data));
      allow update: if isAdmin() || (
        isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'premiumPlan', 'premiumExpire', 'freeExpire', 'referralBonus', 'promoDiscount', 'promoRedeemed']))
      );
      allow delete: if isAdmin();
    }

    // ── referrals: taklif qilinganlar va bonuslar ──
    match /referrals/{docId} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── settings: tariflar va sozlamalar (hamma o'qiydi, admin yoza oladi) ──
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── notifications: hamma o'qiy oladi, faqat admin yoza/o'chira oladi ──
    match /notifications/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── leaderboard: hamma o'qiy oladi, faqat o'zi/admin yoza oladi ──
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── promoCodes: faqat admin boshqaradi; redemption FAQAT server
    //    (api/redeem-promo.js, Admin SDK) orqali — mijozga yopiq ──
    match /promoCodes/{code} {
      allow read, write: if isAdmin();
    }

    // ── Qolgan hamma narsa bloklangan ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
