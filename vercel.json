{
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js|firebase-messaging-sw\\.js|manifest\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets|images|partner_img|art_img|videos|fonts|\\.well-known|sw|workbox|manifest|registerSW|firebase-messaging-sw|api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/cron-daily.js": { "maxDuration": 60 },
    "api/cron-reminder.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-reminder",
      "schedule": "0 14 * * *"
    }
  ]
}
